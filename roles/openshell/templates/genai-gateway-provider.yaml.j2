{#
  openshell | provider profile for the EAT GenAI Gateway (LiteLLM, OpenAI-compatible)

  Inputs: openshell_genai_service_host/_port, and _openshell_profile_resource_version
  when updating a stored profile (update is optimistic-concurrency).
#}
id: eat-genai-gateway
{% if _openshell_profile_resource_version | default('') | length > 0 %}
resource_version: {{ _openshell_profile_resource_version }}
{% endif %}
display_name: EAT GenAI Gateway (LiteLLM)
description: Intel® Enterprise Agent Toolkit LiteLLM gateway (OpenAI-compatible)
category: inference
inference_capable: true
credentials:
  - name: api_key
    description: LiteLLM virtual key (model-scoped, budgeted)
    env_vars: [OPENAI_API_KEY]
    required: true
    auth_style: bearer
    header_name: authorization
endpoints:
  - host: "{{ openshell_genai_service_host }}"
    port: {{ openshell_genai_service_port | int }}
    protocol: rest
    access: read-write
    enforcement: enforce
# Binary identity matches the resolved executable path: a venv python resolves to its base
# interpreter. Listed symlinks are resolved when the policy loads; globs are not, so the
# uv-managed interpreter of the default community image is matched by its real path.
binaries:
  - /usr/bin/curl
  - /usr/bin/python3
  - /usr/bin/python3.12
  - /usr/local/bin/python3
  - /usr/local/bin/python3.12
  - /sandbox/.uv/python/**
  # OpenCode (community image): its Node launcher execs this binary.
  - /usr/lib/node_modules/opencode-ai/bin/.opencode
